# ---------------------------------------------------------------------------
# QuestAI - environment template
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# Every value below is the code's own default unless marked REQUIRED.
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED - the backend will not start or every request will fail without these
# ===========================================================================

# SerpApi. The ONLY search provider in the whole product - every agent reads
# from it. Free tier: 250 searches/month. https://serpapi.com
SERP_API_KEY=

# Groq. Runs every LLM node (planner, evaluator, synthesizer, intent router,
# resume parser). https://console.groq.com
GROQ_API_KEY=

# MongoDB. A free Atlas cluster works: https://www.mongodb.com/atlas
# Must be reachable from your machine (Atlas: add your IP to the access list).
MONGODB_URI=

# Signs the JWTs and the OAuth session cookie. REQUIRED even though it defaults
# to "" - an empty HMAC secret means anyone can forge a token.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=


# ===========================================================================
# Ports and URLs
# ===========================================================================

# Backend port. CORS allows the frontend on 5173, 3000, or 127.0.0.1:5173.
AUTH_PORT=8000

# Where the backend sends the browser after Google OAuth, and where the
# frontend is served from.
FRONTEND_URL=http://localhost:5173


# ===========================================================================
# Tokens
# ===========================================================================

JWT_ALGORITHM=HS256
JWT_EXPIRE_MIN=60
REFRESH_EXPIRE_DAYS=7

# One-time password sent to the email address on signup / password reset.
OTP_EXPIRE_SEC=600
# Minimum seconds between two OTP emails to the same address.
RESEND_COOLDOWN_SEC=30


# ===========================================================================
# Google OAuth - OPTIONAL
# Leave blank to hide the "Continue with Google" button.
# To enable: create an OAuth 2.0 Web Client in the Google Cloud console and add
# this EXACT string under "Authorized redirect URIs". Note it points at the
# BACKEND (port 8000), not the frontend - the backend handles the code exchange
# and then redirects the browser to {FRONTEND_URL}/auth/callback with the tokens
# in the URL fragment.
# ===========================================================================

GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback


# ===========================================================================
# SMTP - OPTIONAL
# Only needed to receive OTP and password-change emails. With no SMTP settings
# the app still runs, but signup and password reset cannot deliver a code.
# Gmail requires an App Password, not your account password.
# ===========================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender shown on those emails. Defaults to SMTP_USERNAME.
MAIL_FROM=


# ===========================================================================
# n8n scheduler - OPTIONAL
# Shared secret for the two machine-only job-alert endpoints
# (/api/jobs/alerts/due and /api/jobs/alerts/{id}/run), which n8n calls with an
# X-Service-Key header instead of a user JWT. If this is blank those endpoints
# return 503 and nothing else changes. Store the same value in n8n.
# Server-side only - it must never reach the frontend bundle.
# ===========================================================================

N8N_SERVICE_KEY=


# ===========================================================================
# Advanced - OPTIONAL
# ===========================================================================

# Comma-separated Groq model ids tried in order when parsing a resume PDF.
# Empty means use the built-in list.
GROQ_VISION_MODELS=
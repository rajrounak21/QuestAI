# ---------------------------------------------------------------------------
# QuestAI - environment template
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# Every value below is the code's own default unless marked REQUIRED.
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED - the backend will not start or every request will fail without these
# ===========================================================================

# SerpApi. The only search provider - every agent reads from it. Free tier:
# 250 searches/month. https://serpapi.com
SERP_API_KEY=

# Groq. Every LLM node, including resume-image parsing.
# https://console.groq.com
GROQ_API_KEY=

# MongoDB. A free Atlas cluster works: https://www.mongodb.com/atlas
# Must be reachable from your machine (Atlas: add your IP to the access list).
MONGODB_URI=

# Signs the JWTs and the OAuth session cookie. REQUIRED even though it defaults
# to "" - an empty HMAC secret means anyone can forge a token.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=


# ===========================================================================
# Ports and URLs
# ===========================================================================

# Backend port. CORS allows the frontend on 5173, 3000, or 127.0.0.1:5173.
AUTH_PORT=8000

# Where the backend sends the browser after Google OAuth, and where the
# frontend is served from.
FRONTEND_URL=http://localhost:5173


# ===========================================================================
# Tokens
# ===========================================================================

JWT_ALGORITHM=HS256
JWT_EXPIRE_MIN=60
REFRESH_EXPIRE_DAYS=7

# One-time password sent to the email address on signup / password reset.
OTP_EXPIRE_SEC=600
# Minimum seconds between two OTP emails to the same address.
RESEND_COOLDOWN_SEC=30


# ===========================================================================
# Google OAuth - OPTIONAL
# Blank hides the "Continue with Google" button. To enable, add this EXACT string
# to the client's "Authorized redirect URIs". It points at the BACKEND, not the
# frontend: the backend does the code exchange, then redirects to
# {FRONTEND_URL}/auth/callback with the tokens in the fragment.
# ===========================================================================

GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback


# ===========================================================================
# SMTP - OPTIONAL
# Needed to deliver OTP and password-change emails. Without it the app runs but
# cannot send a code. Gmail requires an App Password.
# ===========================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender for those emails. Defaults to SMTP_USERNAME.
MAIL_FROM=


# ===========================================================================
# n8n scheduler - OPTIONAL
# Shared secret for the two machine-only job-alert endpoints (/alerts/due and
# /alerts/{id}/run), which n8n calls with X-Service-Key instead of a user JWT.
# Blank makes them return 503 and changes nothing else. Store the same value in
# n8n. Server-side only - must never reach the frontend bundle.
# ===========================================================================

N8N_SERVICE_KEY=